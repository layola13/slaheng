// grade.sla —— 衡 · Heng 判分运行时 CLI（单份入口）
//
// 判定核在 grade_lib.sla（本文件经 @import 引入）；批量并发入口在
// grade_batch.sla（期二首项，设计见仓根 CONCURRENCY.md）。
// 用法与退出码契约见 grade/README.md（与 v0.1 逐字节一致）。

@import "sa_std/encoding/json.sai"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../check/c1.sla"
@import "grade_lib.sla"

fn main() -> i32 {
    let abuf: u64 = sa_env_args_json();
    let ap: ptr = sa_env_buffer_data(abuf);
    let an: u64 = sa_env_buffer_len(abuf);
    let args: u64 = sa_json_parse(ap, an);
    if args == 0 { return fatal(2, STR_PTR("无法读取命令行参数"), STR_LEN("无法读取命令行参数")); };
    if jcount(args) < 3 { return fatal(2, STR_PTR("用法：grade <problem.json> <answer.json>"), STR_LEN("用法：grade <problem.json> <answer.json>")); };
    let p1 = jnode_str(jidx(args, 1));
    let p2 = jnode_str(jidx(args, 2));
    if !p1.ok { return fatal(2, STR_PTR("用法：grade <problem.json> <answer.json>"), STR_LEN("用法：grade <problem.json> <answer.json>")); };
    if !p2.ok { return fatal(2, STR_PTR("用法：grade <problem.json> <answer.json>"), STR_LEN("用法：grade <problem.json> <answer.json>")); };
    let prob = read_json_file(p1.p, p1.n);
    if !prob.ok { return fatal(3, STR_PTR("题目文件读取或 JSON 解析失败"), STR_LEN("题目文件读取或 JSON 解析失败")); };
    let ans = read_json_file(p2.p, p2.n);
    if !ans.ok { return fatal(3, STR_PTR("答案文件读取或 JSON 解析失败"), STR_LEN("答案文件读取或 JSON 解析失败")); };
    if sa_json_kind(prob.doc) != 7 { return fatal(4, STR_PTR("题目根节点不是对象"), STR_LEN("题目根节点不是对象")); };
    if sa_json_kind(ans.doc) != 7 { return fatal(4, STR_PTR("答案根节点不是对象"), STR_LEN("答案根节点不是对象")); };
    let pid = jget_str(prob.doc, STR_PTR("problem_id"), STR_LEN("problem_id"));
    if !pid.ok { return fatal(4, STR_PTR("题目缺少 problem_id"), STR_LEN("题目缺少 problem_id")); };
    let pid_match: bool = true;
    if jhas(ans.doc, STR_PTR("problem_id"), STR_LEN("problem_id")) {
        let apid = jget_str(ans.doc, STR_PTR("problem_id"), STR_LEN("problem_id"));
        if !apid.ok { return fatal(4, STR_PTR("answer.problem_id 不是字符串"), STR_LEN("answer.problem_id 不是字符串")); };
        pid_match = bytes_eq(apid.p, apid.n, pid.p, pid.n);
    };
    if !pid_match { return fatal(4, STR_PTR("answer.problem_id 与题目不一致"), STR_LEN("answer.problem_id 与题目不一致")); };
    let anode: u64 = jget(prob.doc, STR_PTR("assertions"), STR_LEN("assertions"));
    if anode == 0 { return fatal(4, STR_PTR("题目缺少 assertions"), STR_LEN("题目缺少 assertions")); };
    if sa_json_kind(anode) != 6 { return fatal(4, STR_PTR("assertions 不是数组"), STR_LEN("assertions 不是数组")); };
    if jhas(prob.doc, STR_PTR("rubric"), STR_LEN("rubric")) {
        let rnode: u64 = jget(prob.doc, STR_PTR("rubric"), STR_LEN("rubric"));
        if sa_json_kind(rnode) != 6 { return fatal(4, STR_PTR("rubric 必须为数组"), STR_LEN("rubric 必须为数组")); };
    };
    let inode: u64 = jget(ans.doc, STR_PTR("items"), STR_LEN("items"));
    if inode != 0 {
        if sa_json_kind(inode) != 6 { return fatal(4, STR_PTR("answer.items 不是数组"), STR_LEN("answer.items 不是数组")); };
    };
    let ac: u64 = jcount(anode);
    let ic: u64 = 0;
    if inode != 0 { ic = jcount(inode); };
    out_lit(STR_PTR("{\"problem_id\":"), STR_LEN("{\"problem_id\":"));
    out_jstr(pid.p, pid.n);
    out_lit(STR_PTR(",\"results\":["), STR_LEN(",\"results\":["));
    let all_pass: bool = true;
    let i: u64 = 0;
    while i < ac {
        if i > 0 { out_lit(STR_PTR(","), STR_LEN(",")); };
        let asn: u64 = jidx(anode, i);
        let item: u64 = 0;
        if i < ic { item = jidx(inode, i); };
        let d = DBuf { b: [0u8; 3072], n: 0 };
        let rp: bool = judge_one(asn, item, &d);
        if !rp { all_pass = false; };
        out_lit(STR_PTR("{\"assertion_index\":"), STR_LEN("{\"assertion_index\":"));
        out_u64(i);
        out_lit(STR_PTR(",\"pass\":"), STR_LEN(",\"pass\":"));
        if rp { out_lit(STR_PTR("true"), STR_LEN("true")); } else { out_lit(STR_PTR("false"), STR_LEN("false")); };
        out_lit(STR_PTR(",\"detail\":"), STR_LEN(",\"detail\":"));
        out_dbuf_json(&d);
        out_lit(STR_PTR(",\"provenance\":[\"derived\"]}"), STR_LEN(",\"provenance\":[\"derived\"]}"));
        i = i + 1;
    }
    out_lit(STR_PTR("],\"all_pass\":"), STR_LEN("],\"all_pass\":"));
    if all_pass { out_lit(STR_PTR("true"), STR_LEN("true")); } else { out_lit(STR_PTR("false"), STR_LEN("false")); };
    out_lit(STR_PTR("}\n"), STR_LEN("}\n"));
    return 0;
}
