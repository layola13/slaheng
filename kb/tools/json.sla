// kb/tools/json.sla —— 衡 · Heng 最小 JSON 读取器（纯 SLA 实现，零依赖 std JSON 面）
//
// 衡的线间交换格式是 JSON（见仓根 INTERFACE.md），引擎本体需要一个
// 可控、可审计的 JSON 读取面：本文件即该读取器。设计要点：
//   * 输入为 (ptr, len) 字节缓冲，递归下降解析，错误一律响亮（err 标志 + 返回 -1），
//     绝不产出半成品冒充成功。
//   * 值模型为节点池（Vec 并行列）：kind 0 null / 1 bool / 2 int / 3 dec（精确十进制）/
//     4 string / 5 array / 6 object / 7 member（对象成员，child 指向值节点）。
//     存储走 Vec 堆分配：JsonDoc 结构体本身保持小体积，避免大数组字面量
//     拖垮编译（固定大数组展开会让 SAB 构建慢两个数量级，实测教训）。
//   * 数字一律精确表示：整数存 i64；小数存 (mantissa, scale)，value = mantissa / 10^scale，
//     全程不经浮点（衡的判定纪律：数值不用浮点做判定）。
//   * 字符串在解析时即解码（\" \\ \/ \b \f \n \r \t \uXXXX，含代理对）写入字节池，
//     节点存池内 (off, len)；其余字节（含 UTF-8 多字节）原样透传。
//   * 对象成员按键查找为「后出现者胜」（与主流 JSON 语义一致）。
// 容量护栏：节点 16384、池 262144 字节；溢出 panic(92xx) 响亮失败，不静默截断。

@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// ---------- 容量 ----------
fn j_max_nodes() -> u64 { return 16384; }
fn j_max_pool() -> u64 { return 262144; }

// ---------- 节点 kind ----------
fn jk_null() -> i64 { return 0; }
fn jk_bool() -> i64 { return 1; }
fn jk_int() -> i64 { return 2; }
fn jk_dec() -> i64 { return 3; }
fn jk_str() -> i64 { return 4; }
fn jk_arr() -> i64 { return 5; }
fn jk_obj() -> i64 { return 6; }
fn jk_member() -> i64 { return 7; }

struct JsonDoc {
    kind: Vec<i64>,
    ival: Vec<i64>,
    mant: Vec<i64>,
    scale: Vec<i64>,
    soff: Vec<u64>,
    slen: Vec<u64>,
    child: Vec<i64>,
    next: Vec<i64>,
    pool: Vec<u8>,
    pos: u64,
    err: bool,
}

fn json_doc_new() -> JsonDoc {
    return JsonDoc {
        kind: Vec::new(), ival: Vec::new(), mant: Vec::new(), scale: Vec::new(),
        soff: Vec::new(), slen: Vec::new(), child: Vec::new(), next: Vec::new(),
        pool: Vec::new(), pos: 0, err: false,
    };
}

fn j_n_nodes(doc: &JsonDoc) -> u64 { return len(doc.kind); }
fn j_pool_len(doc: &JsonDoc) -> u64 { return len(doc.pool); }

// ---------- 字节访问 ----------
fn j_byte(src: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, src, i);
    return b;
}

fn j_pool_byte(doc: &JsonDoc, off: u64) -> u8 {
    return doc.pool[off];
}

fn j_is_ws(b: u8) -> bool { return b == 32 || b == 9 || b == 10 || b == 13; }
fn j_is_digit(b: u8) -> bool { return b >= 48 && b <= 57; }

fn j_skip_ws(doc: &JsonDoc, src: ptr, n: u64) {
    let going: bool = true;
    while going {
        if doc.pos < n {
            if j_is_ws(j_byte(src, doc.pos)) {
                doc.pos = doc.pos + 1;
            } else { going = false; };
        } else { going = false; };
    }
}

// ---------- 池 ----------
fn j_pool_push(doc: &JsonDoc, b: u8) {
    if j_pool_len(doc) >= j_max_pool() { panic(9201); };
    doc.pool.push(b);
}

// ---------- 节点 ----------
fn j_new_node(doc: &JsonDoc, kind: i64) -> i64 {
    if j_n_nodes(doc) >= j_max_nodes() { panic(9202); };
    doc.kind.push(kind);
    doc.ival.push(0);
    doc.mant.push(0);
    doc.scale.push(0);
    doc.soff.push(0);
    doc.slen.push(0);
    doc.child.push(-1);
    doc.next.push(-1);
    return (j_n_nodes(doc) - 1) as i64;
}

// ---------- 字符串解析（解码入池） ----------
struct JSpan { ok: bool, off: u64, len: u64 }

fn j_hex_val(b: u8) -> i64 {
    if b >= 48 && b <= 57 { return (b - 48) as i64; };
    if b >= 65 && b <= 70 { return (b - 55) as i64; };
    if b >= 97 && b <= 102 { return (b - 87) as i64; };
    return -1;
}

// 读 4 位十六进制（doc.pos 处起），成功推进并返回码点，失败返回 -1 且置 err。
fn j_read_hex4(doc: &JsonDoc, src: ptr, n: u64) -> i64 {
    if doc.pos + 4 > n { doc.err = true; return -1; };
    let v: i64 = 0;
    let i: u64 = 0;
    while i < 4 {
        let h: i64 = j_hex_val(j_byte(src, doc.pos + i));
        if h < 0 { doc.err = true; return -1; };
        v = v * 16 + h;
        i = i + 1;
    }
    doc.pos = doc.pos + 4;
    return v;
}

fn j_pool_push_utf8(doc: &JsonDoc, cp: i64) {
    if cp < 128 {
        j_pool_push(doc, cp as u8);
    } else {
        if cp < 2048 {
            j_pool_push(doc, (192 + cp / 64) as u8);
            j_pool_push(doc, (128 + cp % 64) as u8);
        } else {
            if cp < 65536 {
                j_pool_push(doc, (224 + cp / 4096) as u8);
                j_pool_push(doc, (128 + (cp / 64) % 64) as u8);
                j_pool_push(doc, (128 + cp % 64) as u8);
            } else {
                j_pool_push(doc, (240 + cp / 262144) as u8);
                j_pool_push(doc, (128 + (cp / 4096) % 64) as u8);
                j_pool_push(doc, (128 + (cp / 64) % 64) as u8);
                j_pool_push(doc, (128 + cp % 64) as u8);
            };
        };
    };
}

// 前置条件：src[doc.pos] == '"'。成功返回解码后池跨度并使 pos 越过闭引号。
fn j_parse_string(doc: &JsonDoc, src: ptr, n: u64) -> JSpan {
    let bad = JSpan { ok: false, off: 0, len: 0 };
    let start: u64 = j_pool_len(doc);
    doc.pos = doc.pos + 1;
    let going: bool = true;
    while going {
        if doc.pos >= n {
            doc.err = true;
            return bad;
        };
        let b: u8 = j_byte(src, doc.pos);
        if b == 34 {
            doc.pos = doc.pos + 1;
            going = false;
        } else {
            if b == 92 {
                doc.pos = doc.pos + 1;
                if doc.pos >= n { doc.err = true; return bad; };
                let e: u8 = j_byte(src, doc.pos);
                doc.pos = doc.pos + 1;
                if e == 34 { j_pool_push(doc, 34); } else {
                    if e == 92 { j_pool_push(doc, 92); } else {
                        if e == 47 { j_pool_push(doc, 47); } else {
                            if e == 98 { j_pool_push(doc, 8); } else {
                                if e == 102 { j_pool_push(doc, 12); } else {
                                    if e == 110 { j_pool_push(doc, 10); } else {
                                        if e == 114 { j_pool_push(doc, 13); } else {
                                            if e == 116 { j_pool_push(doc, 9); } else {
                                                if e == 117 {
                                                    let cp: i64 = j_read_hex4(doc, src, n);
                                                    if doc.err { return bad; };
                                                    if cp >= 55296 && cp <= 56319 {
                                                        // 高代理：尝试续读 \uDC00-\uDFFF
                                                        if doc.pos + 1 < n {
                                                            if j_byte(src, doc.pos) == 92 && j_byte(src, doc.pos + 1) == 117 {
                                                                doc.pos = doc.pos + 2;
                                                                let lo: i64 = j_read_hex4(doc, src, n);
                                                                if doc.err { return bad; };
                                                                if lo >= 56320 && lo <= 57343 {
                                                                    j_pool_push_utf8(doc, 65536 + (cp - 55296) * 1024 + (lo - 56320));
                                                                } else {
                                                                    // 孤代理对不合：以 U+FFFD 占位（kb 数据面不出现）
                                                                    j_pool_push_utf8(doc, 65533);
                                                                    j_pool_push_utf8(doc, 65533);
                                                                };
                                                            } else {
                                                                j_pool_push_utf8(doc, 65533);
                                                            };
                                                        } else {
                                                            j_pool_push_utf8(doc, 65533);
                                                        };
                                                    } else {
                                                        if cp >= 56320 && cp <= 57343 {
                                                            j_pool_push_utf8(doc, 65533);
                                                        } else {
                                                            j_pool_push_utf8(doc, cp);
                                                        };
                                                    };
                                                } else {
                                                    doc.err = true;
                                                    return bad;
                                                };
                                            };
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            } else {
                if b < 32 {
                    // 严格 JSON：字符串内不许裸控制字符
                    doc.err = true;
                    return bad;
                };
                j_pool_push(doc, b);
                doc.pos = doc.pos + 1;
            };
        };
    }
    return JSpan { ok: true, off: start, len: j_pool_len(doc) - start };
}

// ---------- 数字解析（精确十进制） ----------
// 语法：-? digits (. digits)? ([eE] [+-]? digits)?
// 无小数点/指数 -> int 节点；否则 dec 节点 (mantissa, scale)。有效数字 > 18 位响亮失败。
fn j_parse_number(doc: &JsonDoc, src: ptr, n: u64) -> i64 {
    let neg: bool = false;
    if j_byte(src, doc.pos) == 45 {
        neg = true;
        doc.pos = doc.pos + 1;
    };
    if doc.pos >= n { doc.err = true; return -1; };
    if !j_is_digit(j_byte(src, doc.pos)) { doc.err = true; return -1; };
    // JSON 文法：整数部分前导 0 必须独占（"01"/"00" 非法；"0"/"0.5"/"0e1" 合法）
    if j_byte(src, doc.pos) == 48 {
        if doc.pos + 1 < n {
            if j_is_digit(j_byte(src, doc.pos + 1)) { doc.err = true; return -1; };
        };
    };
    let mant: i64 = 0;
    let sig: u64 = 0;
    let scale: i64 = 0;
    let is_dec: bool = false;
    let going: bool = true;
    while going {
        if doc.pos < n {
            if j_is_digit(j_byte(src, doc.pos)) {
                mant = mant * 10 + (j_byte(src, doc.pos) - 48) as i64;
                sig = sig + 1;
                if sig > 18 { doc.err = true; return -1; };
                doc.pos = doc.pos + 1;
            } else { going = false; };
        } else { going = false; };
    }
    if doc.pos < n {
        if j_byte(src, doc.pos) == 46 {
            is_dec = true;
            doc.pos = doc.pos + 1;
            if doc.pos >= n { doc.err = true; return -1; };
            if !j_is_digit(j_byte(src, doc.pos)) { doc.err = true; return -1; };
            going = true;
            while going {
                if doc.pos < n {
                    if j_is_digit(j_byte(src, doc.pos)) {
                        mant = mant * 10 + (j_byte(src, doc.pos) - 48) as i64;
                        sig = sig + 1;
                        scale = scale + 1;
                        if sig > 18 { doc.err = true; return -1; };
                        doc.pos = doc.pos + 1;
                    } else { going = false; };
                } else { going = false; };
            }
        };
    };
    if doc.pos < n {
        let e: u8 = j_byte(src, doc.pos);
        if e == 101 || e == 69 {
            is_dec = true;
            doc.pos = doc.pos + 1;
            let eneg: bool = false;
            if doc.pos < n {
                let s: u8 = j_byte(src, doc.pos);
                if s == 45 { eneg = true; doc.pos = doc.pos + 1; } else {
                    if s == 43 { doc.pos = doc.pos + 1; };
                };
            };
            if doc.pos >= n { doc.err = true; return -1; };
            if !j_is_digit(j_byte(src, doc.pos)) { doc.err = true; return -1; };
            let ev: i64 = 0;
            going = true;
            while going {
                if doc.pos < n {
                    if j_is_digit(j_byte(src, doc.pos)) {
                        ev = ev * 10 + (j_byte(src, doc.pos) - 48) as i64;
                        if ev > 10000 { doc.err = true; return -1; };
                        doc.pos = doc.pos + 1;
                    } else { going = false; };
                } else { going = false; };
            }
            if eneg { scale = scale + ev; } else { scale = scale - ev; };
        };
    };
    if neg { mant = 0 - mant; };
    if !is_dec {
        let node: i64 = j_new_node(doc, jk_int());
        doc.ival[node as u64] = mant;
        return node;
    };
    let node2: i64 = j_new_node(doc, jk_dec());
    doc.mant[node2 as u64] = mant;
    doc.scale[node2 as u64] = scale;
    return node2;
}

// ---------- 字面量 ----------
fn j_match_lit(doc: &JsonDoc, src: ptr, n: u64, lit: ptr, lit_len: u64) -> bool {
    if doc.pos + lit_len > n { return false; };
    let i: u64 = 0;
    while i < lit_len {
        let a: u8 = 0;
        PTR_BYTE_AT(a, src, doc.pos + i);
        let b: u8 = 0;
        PTR_BYTE_AT(b, lit, i);
        if a != b { return false; };
        i = i + 1;
    }
    doc.pos = doc.pos + lit_len;
    return true;
}

// ---------- 值解析（递归） ----------
fn j_parse_value(doc: &JsonDoc, src: ptr, n: u64) -> i64 {
    j_skip_ws(doc, src, n);
    if doc.pos >= n { doc.err = true; return -1; };
    let b: u8 = j_byte(src, doc.pos);
    if b == 123 { return j_parse_object(doc, src, n); };
    if b == 91 { return j_parse_array(doc, src, n); };
    if b == 34 {
        let sp = j_parse_string(doc, src, n);
        if !sp.ok { return -1; };
        let node: i64 = j_new_node(doc, jk_str());
        doc.soff[node as u64] = sp.off;
        doc.slen[node as u64] = sp.len;
        return node;
    };
    if b == 116 {
        if j_match_lit(doc, src, n, STR_PTR("true"), 4) {
            let node: i64 = j_new_node(doc, jk_bool());
            doc.ival[node as u64] = 1;
            return node;
        };
        doc.err = true;
        return -1;
    };
    if b == 102 {
        if j_match_lit(doc, src, n, STR_PTR("false"), 5) {
            let node: i64 = j_new_node(doc, jk_bool());
            doc.ival[node as u64] = 0;
            return node;
        };
        doc.err = true;
        return -1;
    };
    if b == 110 {
        if j_match_lit(doc, src, n, STR_PTR("null"), 4) {
            return j_new_node(doc, jk_null());
        };
        doc.err = true;
        return -1;
    };
    if b == 45 || j_is_digit(b) {
        return j_parse_number(doc, src, n);
    };
    doc.err = true;
    return -1;
}

fn j_parse_array(doc: &JsonDoc, src: ptr, n: u64) -> i64 {
    let arr: i64 = j_new_node(doc, jk_arr());
    doc.pos = doc.pos + 1;
    j_skip_ws(doc, src, n);
    if doc.pos < n {
        if j_byte(src, doc.pos) == 93 {
            doc.pos = doc.pos + 1;
            return arr;
        };
    };
    let last: i64 = -1;
    let going: bool = true;
    while going {
        let val: i64 = j_parse_value(doc, src, n);
        if val < 0 { return -1; };
        if last < 0 {
            doc.child[arr as u64] = val;
        } else {
            doc.next[last as u64] = val;
        };
        last = val;
        j_skip_ws(doc, src, n);
        if doc.pos >= n { doc.err = true; return -1; };
        let c: u8 = j_byte(src, doc.pos);
        if c == 44 {
            doc.pos = doc.pos + 1;
        } else {
            if c == 93 {
                doc.pos = doc.pos + 1;
                going = false;
            } else {
                doc.err = true;
                return -1;
            };
        };
    }
    return arr;
}

fn j_parse_object(doc: &JsonDoc, src: ptr, n: u64) -> i64 {
    let obj: i64 = j_new_node(doc, jk_obj());
    doc.pos = doc.pos + 1;
    j_skip_ws(doc, src, n);
    if doc.pos < n {
        if j_byte(src, doc.pos) == 125 {
            doc.pos = doc.pos + 1;
            return obj;
        };
    };
    let last: i64 = -1;
    let going: bool = true;
    while going {
        j_skip_ws(doc, src, n);
        if doc.pos >= n { doc.err = true; return -1; };
        if j_byte(src, doc.pos) != 34 { doc.err = true; return -1; };
        let key = j_parse_string(doc, src, n);
        if !key.ok { return -1; };
        j_skip_ws(doc, src, n);
        if doc.pos >= n { doc.err = true; return -1; };
        if j_byte(src, doc.pos) != 58 { doc.err = true; return -1; };
        doc.pos = doc.pos + 1;
        let val: i64 = j_parse_value(doc, src, n);
        if val < 0 { return -1; };
        let mem: i64 = j_new_node(doc, jk_member());
        doc.soff[mem as u64] = key.off;
        doc.slen[mem as u64] = key.len;
        doc.child[mem as u64] = val;
        if last < 0 {
            doc.child[obj as u64] = mem;
        } else {
            doc.next[last as u64] = mem;
        };
        last = mem;
        j_skip_ws(doc, src, n);
        if doc.pos >= n { doc.err = true; return -1; };
        let c: u8 = j_byte(src, doc.pos);
        if c == 44 {
            doc.pos = doc.pos + 1;
        } else {
            if c == 125 {
                doc.pos = doc.pos + 1;
                going = false;
            } else {
                doc.err = true;
                return -1;
            };
        };
    }
    return obj;
}

// 顶层解析：整段必须恰好是一个 JSON 值（尾随非空白即错误，与主流解析器一致）。
// 成功返回根节点下标，失败返回 -1 且 doc.err 置位。doc 须为空文档或可追加状态：
// 节点/池只追加，重复调用会在同一 doc 上继续累积（调用方需隔离时请用新 doc）。
fn json_parse(doc: &JsonDoc, src: ptr, n: u64) -> i64 {
    doc.pos = 0;
    doc.err = false;
    let root: i64 = j_parse_value(doc, src, n);
    if root < 0 { return -1; };
    j_skip_ws(doc, src, n);
    if doc.pos != n {
        doc.err = true;
        return -1;
    };
    return root;
}

// ---------- 访问器 ----------
fn j_kind(doc: &JsonDoc, node: i64) -> i64 {
    if node < 0 { return -1; };
    return doc.kind[node as u64];
}

// 池跨度与裸字节跨度逐字节相等？
fn j_span_eq(doc: &JsonDoc, off: u64, len: u64, tp: ptr, tn: u64) -> bool {
    if len != tn { return false; };
    let i: u64 = 0;
    while i < len {
        if j_pool_byte(doc, off + i) != j_byte(tp, i) { return false; };
        i = i + 1;
    }
    return true;
}

// 字符串节点与裸字节相等？
fn j_str_eq(doc: &JsonDoc, node: i64, tp: ptr, tn: u64) -> bool {
    if j_kind(doc, node) != jk_str() { return false; };
    return j_span_eq(doc, doc.soff[node as u64], doc.slen[node as u64], tp, tn);
}

// 注：本文件不提供 *_lit 便捷包装——字符串字面量必须在调用点以
// STR_PTR(".."), STR_LEN("..") 原地提取为 (ptr, len) 再传入（String/字面量
// 跨函数传参的 ABI 缺口，见 validate_kb.sla 文件内纪律注）。

// 对象按键取值（后出现者胜）；无此键返回 -1。
fn j_obj_get(doc: &JsonDoc, obj: i64, kp: ptr, kn: u64) -> i64 {
    if j_kind(doc, obj) != jk_obj() { return -1; };
    let found: i64 = -1;
    let mem: i64 = doc.child[obj as u64];
    while mem >= 0 {
        if j_span_eq(doc, doc.soff[mem as u64], doc.slen[mem as u64], kp, kn) {
            found = doc.child[mem as u64];
        };
        mem = doc.next[mem as u64];
    }
    return found;
}



// 对象成员数。
fn j_obj_len(doc: &JsonDoc, obj: i64) -> u64 {
    if j_kind(doc, obj) != jk_obj() { return 0; };
    let c: u64 = 0;
    let mem: i64 = doc.child[obj as u64];
    while mem >= 0 {
        c = c + 1;
        mem = doc.next[mem as u64];
    }
    return c;
}

// 第 i 个成员节点（kind=member，soff/slen 为键、child 为值）；越界返回 -1。
fn j_obj_member_at(doc: &JsonDoc, obj: i64, i: u64) -> i64 {
    if j_kind(doc, obj) != jk_obj() { return -1; };
    let mem: i64 = doc.child[obj as u64];
    let k: u64 = 0;
    while mem >= 0 {
        if k == i { return mem; };
        k = k + 1;
        mem = doc.next[mem as u64];
    }
    return -1;
}

fn j_arr_len(doc: &JsonDoc, arr: i64) -> u64 {
    if j_kind(doc, arr) != jk_arr() { return 0; };
    let c: u64 = 0;
    let el: i64 = doc.child[arr as u64];
    while el >= 0 {
        c = c + 1;
        el = doc.next[el as u64];
    }
    return c;
}

fn j_arr_at(doc: &JsonDoc, arr: i64, i: u64) -> i64 {
    if j_kind(doc, arr) != jk_arr() { return -1; };
    let el: i64 = doc.child[arr as u64];
    let k: u64 = 0;
    while el >= 0 {
        if k == i { return el; };
        k = k + 1;
        el = doc.next[el as u64];
    }
    return -1;
}

struct JInt { ok: bool, v: i64 }

// 整数读取：仅 int 节点合法（dec 节点不许冒充整数，判定纪律）。
fn j_int(doc: &JsonDoc, node: i64) -> JInt {
    let r = JInt { ok: false, v: 0 };
    if j_kind(doc, node) != jk_int() { return r; };
    r.ok = true;
    r.v = doc.ival[node as u64];
    return r;
}

struct JDec { ok: bool, mant: i64, scale: i64 }

// 精确十进制读取：int 节点给出 scale=0；dec 节点给出 (mantissa, scale)。
fn j_dec(doc: &JsonDoc, node: i64) -> JDec {
    let r = JDec { ok: false, mant: 0, scale: 0 };
    let k: i64 = j_kind(doc, node);
    if k == jk_int() {
        r.ok = true;
        r.mant = doc.ival[node as u64];
        r.scale = 0;
        return r;
    };
    if k == jk_dec() {
        r.ok = true;
        r.mant = doc.mant[node as u64];
        r.scale = doc.scale[node as u64];
        return r;
    };
    return r;
}

// 数值是否为整数值（int 节点，或小数部分恰为 0 的 dec 节点）及其值。
fn j_as_int_exact(doc: &JsonDoc, node: i64) -> JInt {
    let r = JInt { ok: false, v: 0 };
    let k: i64 = j_kind(doc, node);
    if k == jk_int() {
        r.ok = true;
        r.v = doc.ival[node as u64];
        return r;
    };
    if k == jk_dec() {
        let m: i64 = doc.mant[node as u64];
        let s: i64 = doc.scale[node as u64];
        if s <= 0 {
            let mul: i64 = 1;
            let e: i64 = 0 - s;
            if e > 15 { return r; };
            while e > 0 {
                mul = mul * 10;
                e = e - 1;
            }
            r.ok = true;
            r.v = m * mul;
            return r;
        };
        let div: i64 = 1;
        let e2: i64 = s;
        if e2 > 15 { return r; };
        while e2 > 0 {
            div = div * 10;
            e2 = e2 - 1;
        }
        if m % div != 0 { return r; };
        r.ok = true;
        r.v = m / div;
        return r;
    };
    return r;
}
